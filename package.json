{
  "name": "ellison-group",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "env:pull": "node scripts/sync-environment.mjs",
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "bash tests/database/run.sh",
    "verify:prototype": "node scripts/verify-prototype.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "import:prototype": "node scripts/import-prototype.mjs",
    "audit:hosted-notes": "node --env-file-if-exists=.env.local scripts/audit-note-attribution.mjs",
    "seed:demo": "node scripts/demo-data.mjs",
    "remove:demo": "node scripts/demo-data.mjs --remove"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
